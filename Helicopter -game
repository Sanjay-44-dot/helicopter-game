<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ChopperScream – Voice Controlled Helicopter</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Share+Tech+Mono&display=swap');

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    background: #0a0e1a;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    font-family: 'Share Tech Mono', monospace;
    overflow: hidden;
    color: #e0f0ff;
  }

  h1 {
    font-family: 'Orbitron', sans-serif;
    font-size: 2rem;
    font-weight: 900;
    letter-spacing: 0.15em;
    color: #00e5ff;
    text-shadow: 0 0 20px #00e5ff88, 0 0 40px #00e5ff44;
    margin-bottom: 6px;
  }

  #subtitle {
    font-size: 0.75rem;
    color: #5588aa;
    letter-spacing: 0.2em;
    margin-bottom: 14px;
    text-transform: uppercase;
  }

  #game-wrapper {
    position: relative;
    border: 1.5px solid #00e5ff33;
    border-radius: 4px;
    box-shadow: 0 0 40px #00e5ff22, inset 0 0 60px #00061088;
  }

  canvas {
    display: block;
    border-radius: 3px;
  }

  #hud {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 480px;
    margin-top: 10px;
    padding: 0 4px;
  }

  #score-display {
    font-family: 'Orbitron', sans-serif;
    font-size: 1.1rem;
    color: #00e5ff;
    text-shadow: 0 0 10px #00e5ff;
  }

  #vol-bar-wrap {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  #vol-label { font-size: 0.65rem; color: #4477aa; letter-spacing: 0.1em; }

  #vol-bar-bg {
    width: 120px; height: 10px;
    background: #0a1a2a;
    border: 1px solid #1a3a5a;
    border-radius: 5px;
    overflow: hidden;
  }

  #vol-bar {
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, #00e5ff, #ff4081);
    border-radius: 5px;
    transition: width 0.04s;
  }

  #best-display {
    font-size: 0.7rem;
    color: #446688;
    font-family: 'Orbitron', sans-serif;
  }

  #mic-btn {
    margin-top: 14px;
    background: transparent;
    border: 1.5px solid #00e5ff66;
    color: #00e5ff;
    font-family: 'Orbitron', sans-serif;
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    padding: 8px 24px;
    border-radius: 3px;
    cursor: pointer;
    transition: all 0.2s;
    text-transform: uppercase;
  }
  #mic-btn:hover { background: #00e5ff18; box-shadow: 0 0 15px #00e5ff44; }
  #mic-btn.active { border-color: #ff4081; color: #ff4081; box-shadow: 0 0 15px #ff408144; }

  #msg {
    margin-top: 8px;
    font-size: 0.65rem;
    color: #335566;
    letter-spacing: 0.1em;
  }
</style>
</head>
<body>

<h1>CHOPPERSCREAM</h1>
<div id="subtitle">Scream Louder → Fly Higher</div>

<div id="game-wrapper">
  <canvas id="c" width="480" height="540"></canvas>
</div>

<div id="hud">
  <div id="score-display">SCORE: <span id="score">0</span></div>
  <div id="vol-bar-wrap">
    <span id="vol-label">NOISE</span>
    <div id="vol-bar-bg"><div id="vol-bar"></div></div>
  </div>
  <div id="best-display">BEST: <span id="best">0</span></div>
</div>

<button id="mic-btn">🎙 Enable Mic</button>
<div id="msg">Click Enable Mic then YELL or CLAP to fly!</div>

<script>
const canvas = document.getElementById('c');
const ctx = canvas.getContext('2d');
const W = canvas.width, H = canvas.height;

// ── State ──────────────────────────────────────────────────────────────
let state = 'idle'; // idle | playing | dead
let score = 0, best = 0;
let volume = 0;   // 0–1 normalized mic volume
let micReady = false;

// ── Helicopter ─────────────────────────────────────────────────────────
const heli = {
  x: 110, y: H / 2,
  vy: 0,
  w: 90, h: 38,
  bladeAngle: 0,
  tailBladeAngle: 0,
  tiltAngle: 0,
};

const GRAVITY = 0.38;
const LIFT_MAX = -14;   // max upward force when screaming full volume
const LIFT_THRESHOLD = 0.04; // mic dead zone

// ── Pipes ──────────────────────────────────────────────────────────────
const GAP = 160;
const PIPE_W = 52;
let pipes = [];
let pipeTimer = 0;
const PIPE_INTERVAL = 110; // frames
let gameSpeed = 2.6;

function spawnPipe() {
  const minTop = 60, maxTop = H - GAP - 60;
  const topH = minTop + Math.random() * (maxTop - minTop);
  pipes.push({ x: W + 10, topH, scored: false });
}

// ── Particles ─────────────────────────────────────────────────────────
let particles = [];

function spawnExhaust() {
  if (state !== 'playing') return;
  for (let i = 0; i < 2; i++) {
    particles.push({
      x: heli.x - heli.w * 0.35,
      y: heli.y + heli.h * 0.18 + (Math.random() - 0.5) * 6,
      vx: -1.5 - Math.random() * 2,
      vy: (Math.random() - 0.5) * 0.8,
      life: 1, maxLife: 0.6 + Math.random() * 0.4,
      r: 6 + Math.random() * 4
    });
  }
}

// ── Stars (BG) ─────────────────────────────────────────────────────────
const stars = Array.from({length: 80}, () => ({
  x: Math.random() * W, y: Math.random() * H,
  r: Math.random() * 1.2 + 0.3,
  bright: Math.random()
}));

// ── BG Mountains ──────────────────────────────────────────────────────
const mtnFar  = buildMountain(W, H, 0.55, 6, 42);
const mtnNear = buildMountain(W, H, 0.72, 4, 17);
let bgOffsetFar = 0, bgOffsetNear = 0;

function buildMountain(w, h, yFrac, peaks, seed) {
  const pts = [];
  const step = w / peaks;
  for (let i = 0; i <= peaks; i++) {
    const nx = i * step + (i === 0 || i === peaks ? 0 : (seed * i % 30) - 15);
    const ny = h * yFrac - Math.abs(Math.sin(i * 1.3 + seed) * h * 0.18) - Math.random() * 30;
    pts.push({x: nx, y: ny});
  }
  pts.unshift({x: 0, y: h});
  pts.push({x: w, y: h});
  return pts;
}

function drawMountain(pts, offset, fillStyle) {
  ctx.save();
  ctx.fillStyle = fillStyle;
  ctx.beginPath();
  const shift = offset % W;
  ctx.moveTo(pts[0].x - shift, pts[0].y);
  for (let i = 1; i < pts.length; i++) {
    ctx.lineTo(pts[i].x - shift, pts[i].y);
  }
  // draw again shifted by +W to fill gap
  for (let i = pts.length - 2; i >= 0; i--) {
    ctx.lineTo(pts[i].x - shift + W, pts[i].y);
  }
  ctx.fill();
  ctx.restore();
}

// ── Draw Sky ───────────────────────────────────────────────────────────
function drawSky() {
  const grad = ctx.createLinearGradient(0, 0, 0, H);
  grad.addColorStop(0,    '#050c1f');
  grad.addColorStop(0.5,  '#0a1a3a');
  grad.addColorStop(1,    '#0d2040');
  ctx.fillStyle = grad;
  ctx.fillRect(0, 0, W, H);

  // stars
  stars.forEach(s => {
    ctx.globalAlpha = 0.3 + s.bright * 0.7;
    ctx.fillStyle = '#b0d8ff';
    ctx.beginPath();
    ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
    ctx.fill();
  });
  ctx.globalAlpha = 1;
}

// ── Draw Helicopter ────────────────────────────────────────────────────
function drawHelicopter(x, y, tilt) {
  ctx.save();
  ctx.translate(x, y);
  ctx.rotate(tilt);

  const W2 = heli.w, H2 = heli.h;

  // Shadow
  ctx.save();
  ctx.globalAlpha = 0.15;
  ctx.fillStyle = '#000';
  ctx.scale(1, 0.3);
  ctx.beginPath();
  ctx.ellipse(0, H2 * 2.5, W2 * 0.4, H2 * 0.5, 0, 0, Math.PI * 2);
  ctx.fill();
  ctx.restore();

  // ── TAIL BOOM ───────────────────────────────────────────────────────
  // Tapered tail
  ctx.beginPath();
  ctx.moveTo(-W2 * 0.28, H2 * 0.05);
  ctx.lineTo(-W2 * 0.5,  H2 * 0.18);  // bottom of tail
  ctx.lineTo(-W2 * 0.5,  H2 * 0.05);
  ctx.lineTo(-W2 * 0.28, -H2 * 0.08);
  ctx.closePath();
  const tailGrad = ctx.createLinearGradient(-W2*0.5, 0, -W2*0.28, 0);
  tailGrad.addColorStop(0, '#1a3a55');
  tailGrad.addColorStop(1, '#2a6080');
  ctx.fillStyle = tailGrad;
  ctx.fill();
  // tail fin
  ctx.beginPath();
  ctx.moveTo(-W2 * 0.47, H2 * 0.05);
  ctx.lineTo(-W2 * 0.5,  -H2 * 0.25);
  ctx.lineTo(-W2 * 0.38, H2 * 0.05);
  ctx.closePath();
  ctx.fillStyle = '#1a4060';
  ctx.fill();
  ctx.strokeStyle = '#2a7090';
  ctx.lineWidth = 0.8;
  ctx.stroke();

  // ── MAIN BODY ────────────────────────────────────────────────────────
  // Body gradient
  const bodyGrad = ctx.createLinearGradient(0, -H2 * 0.5, 0, H2 * 0.5);
  bodyGrad.addColorStop(0,   '#3ab0e0');
  bodyGrad.addColorStop(0.3, '#1e7aaa');
  bodyGrad.addColorStop(0.7, '#155a80');
  bodyGrad.addColorStop(1,   '#0d3a55');
  ctx.fillStyle = bodyGrad;

  // Body shape (rounded fuselage)
  ctx.beginPath();
  ctx.moveTo(-W2*0.28, -H2*0.38);
  ctx.bezierCurveTo(-W2*0.28, -H2*0.55, W2*0.12, -H2*0.55, W2*0.25, -H2*0.3);
  ctx.bezierCurveTo(W2*0.42,  -H2*0.1,  W2*0.42,  H2*0.1,  W2*0.3,  H2*0.32);
  ctx.bezierCurveTo(W2*0.1,   H2*0.52,  -W2*0.22, H2*0.48, -W2*0.28, H2*0.28);
  ctx.bezierCurveTo(-W2*0.32, H2*0.1,  -W2*0.32, -H2*0.2,  -W2*0.28, -H2*0.38);
  ctx.closePath();
  ctx.fill();
  // Body outline
  ctx.strokeStyle = '#5ad0f0';
  ctx.lineWidth = 1.2;
  ctx.stroke();

  // ── COCKPIT GLASS ────────────────────────────────────────────────────
  ctx.save();
  ctx.beginPath();
  ctx.moveTo(W2*0.02, -H2*0.42);
  ctx.bezierCurveTo(W2*0.15, -H2*0.52, W2*0.36, -H2*0.38, W2*0.38, -H2*0.12);
  ctx.bezierCurveTo(W2*0.38,  H2*0.12, W2*0.2,   H2*0.28, W2*0.0,   H2*0.28);
  ctx.bezierCurveTo(-W2*0.1,  H2*0.28, -W2*0.1,  -H2*0.3,  W2*0.02, -H2*0.42);
  ctx.closePath();
  // glass gradient
  const glassGrad = ctx.createLinearGradient(W2*0.1, -H2*0.5, W2*0.3, H2*0.2);
  glassGrad.addColorStop(0,   'rgba(140,230,255,0.55)');
  glassGrad.addColorStop(0.4, 'rgba(80,180,230,0.35)');
  glassGrad.addColorStop(1,   'rgba(0,60,100,0.55)');
  ctx.fillStyle = glassGrad;
  ctx.fill();
  // glass shine
  ctx.beginPath();
  ctx.moveTo(W2*0.08, -H2*0.42);
  ctx.bezierCurveTo(W2*0.2, -H2*0.52, W2*0.3, -H2*0.4, W2*0.28, -H2*0.2);
  ctx.strokeStyle = 'rgba(200,245,255,0.6)';
  ctx.lineWidth = 1.5;
  ctx.stroke();
  ctx.restore();

  // ── LANDING SKIDS ────────────────────────────────────────────────────
  ctx.strokeStyle = '#2a6080';
  ctx.lineWidth = 2;
  // left strut
  ctx.beginPath();
  ctx.moveTo(-W2*0.1, H2*0.42);
  ctx.lineTo(-W2*0.18, H2*0.7);
  ctx.stroke();
  // right strut
  ctx.beginPath();
  ctx.moveTo(W2*0.15, H2*0.38);
  ctx.lineTo(W2*0.1, H2*0.7);
  ctx.stroke();
  // skid rail
  ctx.lineWidth = 2.5;
  ctx.beginPath();
  ctx.moveTo(-W2*0.3, H2*0.7);
  ctx.lineTo(W2*0.22, H2*0.7);
  ctx.stroke();

  // ── MAIN ROTOR MAST ──────────────────────────────────────────────────
  ctx.fillStyle = '#1a4060';
  ctx.fillRect(-3, -H2*0.65, 6, H2*0.15);

  // ── MAIN ROTOR BLADES ────────────────────────────────────────────────
  ctx.save();
  ctx.translate(0, -H2 * 0.62);
  ctx.rotate(heli.bladeAngle);
  for (let i = 0; i < 3; i++) {
    ctx.save();
    ctx.rotate(i * (Math.PI * 2 / 3));
    // blade shape
    ctx.beginPath();
    ctx.moveTo(-4, -2);
    ctx.bezierCurveTo(-W2*0.1, -4, W2*0.55, -5, W2*0.6, 0);
    ctx.bezierCurveTo(W2*0.55, 5, -W2*0.1, 4, -4, 2);
    ctx.closePath();
    const bladeGrad = ctx.createLinearGradient(0, 0, W2*0.6, 0);
    bladeGrad.addColorStop(0,   '#3ab0e0');
    bladeGrad.addColorStop(0.5, '#1e7aaa');
    bladeGrad.addColorStop(1,   '#0a3a55');
    ctx.fillStyle = bladeGrad;
    ctx.fill();
    ctx.strokeStyle = '#5ad0f0';
    ctx.lineWidth = 0.5;
    ctx.stroke();
    ctx.restore();
  }
  // rotor hub
  ctx.beginPath();
  ctx.arc(0, 0, 5, 0, Math.PI*2);
  ctx.fillStyle = '#60c0e0';
  ctx.fill();
  ctx.restore();

  // ── TAIL ROTOR ────────────────────────────────────────────────────────
  ctx.save();
  ctx.translate(-W2*0.49, H2*0.02);
  ctx.rotate(heli.tailBladeAngle);
  for (let i = 0; i < 2; i++) {
    ctx.save();
    ctx.rotate(i * Math.PI);
    ctx.beginPath();
    ctx.moveTo(-1, -1);
    ctx.bezierCurveTo(0, -H2*0.22, H2*0.1, -H2*0.22, H2*0.12, 0);
    ctx.bezierCurveTo(H2*0.1, H2*0.22, 0, H2*0.22, -1, 1);
    ctx.closePath();
    ctx.fillStyle = '#2a8aaa';
    ctx.fill();
    ctx.restore();
  }
  ctx.beginPath();
  ctx.arc(0, 0, 3, 0, Math.PI*2);
  ctx.fillStyle = '#5ad0f0';
  ctx.fill();
  ctx.restore();

  ctx.restore(); // end helicopter
}

// ── Draw Pipes ─────────────────────────────────────────────────────────
function drawPipe(pipe) {
  const x = pipe.x, tH = pipe.topH, bY = tH + GAP;
  const bH = H - bY;
  const pw = PIPE_W;

  function drawOnePipe(px, py, ph, flipped) {
    ctx.save();
    if (flipped) {
      ctx.translate(px + pw/2, py + ph/2);
      ctx.scale(1, -1);
      ctx.translate(-(px + pw/2), -(py + ph/2));
    }

    // pipe body
    const g = ctx.createLinearGradient(px, 0, px + pw, 0);
    g.addColorStop(0,   '#1a5040');
    g.addColorStop(0.3, '#3aaa70');
    g.addColorStop(0.7, '#1e7a50');
    g.addColorStop(1,   '#0d3a28');
    ctx.fillStyle = g;
    ctx.fillRect(px + 4, py, pw - 8, ph);

    // cap
    const capH = 18;
    ctx.fillStyle = '#22cc66';
    const capG = ctx.createLinearGradient(px, 0, px + pw, 0);
    capG.addColorStop(0, '#1a8a50');
    capG.addColorStop(0.3, '#44ee88');
    capG.addColorStop(1, '#1a6040');
    ctx.fillStyle = capG;
    ctx.beginPath();
    ctx.roundRect(px, py + ph - capH, pw, capH, [0,0,4,4]);
    ctx.fill();

    // shine
    ctx.fillStyle = 'rgba(255,255,255,0.08)';
    ctx.fillRect(px + 6, py, 8, ph);

    ctx.restore();
  }

  drawOnePipe(x, 0, tH, false);    // top pipe
  drawOnePipe(x, bY, bH, false);   // bottom pipe
}

// ── Particles ─────────────────────────────────────────────────────────
function updateDrawParticles() {
  particles = particles.filter(p => p.life > 0);
  particles.forEach(p => {
    p.x += p.vx; p.y += p.vy;
    p.life -= 0.04;
    const alpha = p.life / p.maxLife;
    ctx.save();
    ctx.globalAlpha = alpha * 0.7;
    const g = ctx.createRadialGradient(p.x, p.y, 0, p.x, p.y, p.r);
    g.addColorStop(0, '#ffffff');
    g.addColorStop(0.4, '#aaddff');
    g.addColorStop(1, 'transparent');
    ctx.fillStyle = g;
    ctx.beginPath();
    ctx.arc(p.x, p.y, p.r, 0, Math.PI*2);
    ctx.fill();
    ctx.restore();
  });
}

// ── Collision ──────────────────────────────────────────────────────────
function checkCollision() {
  const hx = heli.x - heli.w * 0.32;
  const hy = heli.y - heli.h * 0.45;
  const hw = heli.w * 0.64;
  const hh = heli.h * 0.75;

  if (hy < 0 || hy + hh > H) return true;

  for (const p of pipes) {
    if (hx + hw > p.x + 4 && hx < p.x + PIPE_W - 4) {
      if (hy < p.topH || hy + hh > p.topH + GAP) return true;
    }
  }
  return false;
}

// ── Overlay drawing ────────────────────────────────────────────────────
function drawOverlay(title, sub) {
  ctx.save();
  ctx.fillStyle = 'rgba(5,10,25,0.72)';
  ctx.fillRect(0, 0, W, H);

  ctx.font = 'bold 2.2rem Orbitron, monospace';
  ctx.fillStyle = '#00e5ff';
  ctx.textAlign = 'center';
  ctx.shadowColor = '#00e5ff';
  ctx.shadowBlur = 20;
  ctx.fillText(title, W/2, H/2 - 30);

  ctx.font = '0.85rem Share Tech Mono, monospace';
  ctx.fillStyle = '#5599bb';
  ctx.shadowBlur = 0;
  ctx.fillText(sub, W/2, H/2 + 10);

  if (!micReady) {
    ctx.font = '0.7rem Share Tech Mono, monospace';
    ctx.fillStyle = '#ff4081';
    ctx.fillText('⚠ Enable Mic first!', W/2, H/2 + 40);
  }
  ctx.restore();
}

// ── Reset ──────────────────────────────────────────────────────────────
function reset() {
  heli.y = H/2; heli.vy = 0; heli.tiltAngle = 0;
  pipes = []; pipeTimer = 0; score = 0; gameSpeed = 2.6;
  particles = [];
  document.getElementById('score').textContent = 0;
}

// ── Main Loop ──────────────────────────────────────────────────────────
let lastTime = 0;

function loop(ts) {
  const dt = Math.min(ts - lastTime, 50);
  lastTime = ts;

  // BG
  drawSky();
  bgOffsetFar  += (state === 'playing' ? gameSpeed * 0.2 : 0);
  bgOffsetNear += (state === 'playing' ? gameSpeed * 0.5 : 0);
  drawMountain(mtnFar,  bgOffsetFar,  '#0f2a40');
  drawMountain(mtnNear, bgOffsetNear, '#0a1e30');

  // Ground line
  ctx.fillStyle = '#0a1e30';
  ctx.fillRect(0, H - 22, W, 22);
  ctx.fillStyle = '#1a4a6a';
  ctx.fillRect(0, H - 22, W, 2);

  if (state === 'playing') {
    // Lift from volume
    const lift = volume > LIFT_THRESHOLD
      ? LIFT_MAX * Math.pow((volume - LIFT_THRESHOLD) / (1 - LIFT_THRESHOLD), 0.7)
      : 0;

    heli.vy += GRAVITY;
    heli.vy += lift;
    heli.vy = Math.max(-12, Math.min(heli.vy, 10));
    heli.y += heli.vy;

    // tilt
    heli.tiltAngle += (heli.vy * 0.025 - heli.tiltAngle) * 0.15;
    heli.tiltAngle = Math.max(-0.35, Math.min(0.35, heli.tiltAngle));

    // blades spin (faster when louder)
    const spinSpeed = 0.12 + volume * 0.28;
    heli.bladeAngle += spinSpeed;
    heli.tailBladeAngle += spinSpeed * 2.5;

    // exhaust
    spawnExhaust();

    // pipes
    pipeTimer++;
    if (pipeTimer >= PIPE_INTERVAL) { spawnPipe(); pipeTimer = 0; }
    pipes.forEach(p => p.x -= gameSpeed);
    pipes = pipes.filter(p => p.x > -PIPE_W - 10);

    // score
    pipes.forEach(p => {
      if (!p.scored && p.x + PIPE_W < heli.x) {
        p.scored = true; score++;
        gameSpeed += 0.06;
        document.getElementById('score').textContent = score;
      }
    });

    if (checkCollision()) {
      state = 'dead';
      if (score > best) { best = score; document.getElementById('best').textContent = best; }
    }
  } else {
    // idle rotor spin
    heli.bladeAngle += 0.05;
    heli.tailBladeAngle += 0.12;
  }

  // Draw pipes
  pipes.forEach(drawPipe);

  // Particles
  updateDrawParticles();

  // Helicopter
  drawHelicopter(heli.x, heli.y, heli.tiltAngle);

  // Volume bar
  document.getElementById('vol-bar').style.width = (volume * 100) + '%';

  // Overlays
  if (state === 'idle') drawOverlay('CHOPPERSCREAM', 'Click here or Press SPACE to Start');
  if (state === 'dead') drawOverlay('CRASHED!', `Score: ${score}  –  Click or SPACE to Retry`);

  requestAnimationFrame(loop);
}

// ── Input ──────────────────────────────────────────────────────────────
canvas.addEventListener('click', handleStart);
document.addEventListener('keydown', e => { if (e.code === 'Space') { e.preventDefault(); handleStart(); } });

function handleStart() {
  if (!micReady) return;
  if (state === 'idle' || state === 'dead') { reset(); state = 'playing'; }
}

// ── Microphone ─────────────────────────────────────────────────────────
document.getElementById('mic-btn').addEventListener('click', async () => {
  try {
    const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
    const ctx2 = new (window.AudioContext || window.webkitAudioContext)();
    const src = ctx2.createMediaStreamSource(stream);
    const analyser = ctx2.createAnalyser();
    analyser.fftSize = 256;
    src.connect(analyser);
    const data = new Uint8Array(analyser.frequencyBinCount);

    function readVol() {
      analyser.getByteFrequencyData(data);
      let sum = 0;
      for (const v of data) sum += v;
      const avg = sum / data.length;
      // smooth
      const raw = Math.min(avg / 80, 1);
      volume = volume * 0.6 + raw * 0.4;
      requestAnimationFrame(readVol);
    }
    readVol();

    micReady = true;
    const btn = document.getElementById('mic-btn');
    btn.textContent = '🎙 Mic Active';
    btn.classList.add('active');
    document.getElementById('msg').textContent = 'Mic ready! Click the game or press SPACE, then YELL to fly!';
  } catch(e) {
    document.getElementById('msg').textContent = '❌ Mic denied. Please allow microphone access.';
  }
});

// ── Start ──────────────────────────────────────────────────────────────
requestAnimationFrame(ts => { lastTime = ts; loop(ts); });
</script>
</body>
